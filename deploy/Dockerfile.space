# Deployment image for Hugging Face Spaces (Docker SDK, free CPU tier:
# 2 vCPU / 16GB RAM). Build context is the REPO ROOT, not backend/ — it needs
# both halves.
#
# One container serves both the API and the frontend, so the browser talks to a
# single origin and there is no CORS boundary to configure or get wrong.
#
# The teacher runs on NVIDIA NIM here rather than locally: a 7B model on two
# shared vCPUs would take minutes per message. The student gate still runs
# locally on CPU, which is the point of the cascade — most messages never
# reach the hosted model at all.

# --- stage 1: build the frontend -------------------------------------------
FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Empty = same origin. The API serves this bundle, so a relative /analyze
# resolves correctly with no host baked in at build time.
ENV VITE_API_BASE=""
RUN npm run build

# --- stage 2: the app -------------------------------------------------------
FROM python:3.12-slim

# HF Spaces runs the container as uid 1000. Create that user before anything
# is written, and --chown every COPY, or the app cannot read its own files.
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1
WORKDIR $HOME/app

# CPU torch explicitly, from the CPU index. A plain install resolves to the
# CUDA build: ~2.5GB of GPU libraries that cannot run on this host.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY --chown=user backend/requirements-serve.txt ./
RUN pip install --no-cache-dir -r requirements-serve.txt

COPY --chown=user backend/app/ ./app/
COPY --chown=user backend/data/counter_moves.yaml ./data/counter_moves.yaml
COPY --chown=user --from=frontend /build/dist ./static/

# Bake the student weights into the image at build time rather than pulling
# them on first request. The free tier has no persistent volume, so a runtime
# download would repeat on every cold start; /data isn't available during
# build either. STUDENT_HF_REPO must be passed at build time:
#   --build-arg STUDENT_HF_REPO=<user>/the-tell-student-modernbert
ARG STUDENT_HF_REPO=""
ENV STUDENT_HF_REPO=$STUDENT_HF_REPO
RUN if [ -n "$STUDENT_HF_REPO" ]; then \
      python -c "from huggingface_hub import snapshot_download; snapshot_download('$STUDENT_HF_REPO')" ; \
    else \
      echo "WARNING: no STUDENT_HF_REPO — the gate will be skipped and every message will hit the teacher." ; \
    fi

ENV LLM_BACKEND=nim \
    STATIC_DIR=/home/user/app/static \
    PORT=7860
# NIM_API_KEY is NOT set here. It comes from the Space's secrets at runtime.

EXPOSE 7860
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
