# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Data — large/re-downloadable public datasets and mechanically-rebuilt
# output are excluded; hand-authored and hand-labeled files are NOT (they're
# original work product, not re-downloadable, and small).
backend/data/corpus/raw/*
!backend/data/corpus/raw/handcrafted_india.jsonl
!backend/data/corpus/raw/handcrafted_india_train.jsonl
backend/data/corpus/processed/
!backend/data/corpus/gold/

# Models — trained checkpoints are large binary artifacts (the distilled
# student alone is ~600MB), never commit them regardless of nesting depth.
backend/models/
*.gguf

# Study data — participant responses, even scrubbed
# (dir contents, not the dir itself - git won't descend into an excluded
# directory, so the negation below only works against `study/data/*`)
study/data/*
!study/data/aggregate_counts.json
study/*.csv

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env / secrets (should never be needed, but block by default)
.env
.env.*
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Eval caches (mechanically regenerable)
backend/eval/.cache/

# Local agent instructions - not part of the published project.
# The durable engineering rules a reader needs live in
# docs/DESIGN_RULES.md, which IS committed.
CLAUDE.md
